[Unit]
Description=Pi Picture Frame Web Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pi-pic-frame
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/pi-pic-frame/.venv/bin/picture-frame-web --config /opt/pi-pic-frame/config.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
